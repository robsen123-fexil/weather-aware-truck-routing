# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production (Render) examples — set in the host dashboard, not in git:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=your-service.onrender.com
# DJANGO_SECURE_SSL_REDIRECT=True
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# CORS — comma-separated origins for the React frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000

# OpenRouteService (geocoding + routing)
# Free key: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=

# Open-Meteo — free endpoint needs no key. For production rate limits, set a
# commercial key and base URL: https://customer-api.open-meteo.com/v1
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_API_KEY=

# Defaults
DEFAULT_CHECKPOINT_INTERVAL_MILES=25
ROUTING_PROFILE=driving-hgv
HTTP_TIMEOUT_SECONDS=30
